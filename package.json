{
  "name": "lineops-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:unit && npm run test:frontend",
    "test:unit": "node --test tests/*.test.mjs",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "check:server": "node --check server.mjs && node --check server/celinePrompt.mjs && node --check server/runtimeUtils.mjs && node --check server/security.mjs && node --check server/shiftGuideDefaults.mjs && node --check shared/shiftGuideContract.js && node --check shared/shiftGuideProgress.js",
    "check": "npm run check:server && npm test && npm run lint && npm run build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
