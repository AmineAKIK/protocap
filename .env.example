# Server-only secrets. Never prefix secrets with VITE_.
SHIFTGUIDE_CODE=
DEEPSEEK_API_KEY=

# Céline provider tuning. CELINE_MODEL defaults to deepseek-v4-flash.
# CELINE_MAX_TOKENS defaults to 160 and must stay between 32 and 512.
CELINE_MODEL=deepseek-v4-flash
CELINE_MAX_TOKENS=160

# Protected ShiftGuide data served after unlock.
# Runtime contracts and the SG_URGENCES / SG_CELINE_ROUTING schemas are documented in docs/shiftguide-config.md.
SG_MODULES=
SG_LEXIQUE=
SG_SYSTEM_PROMPT=
# Optional: when omitted, the server uses the repository's validated default emergency payload.
SG_URGENCES=
# Optional: server-only declarative Celine routing. When omitted, the repository default routing contract is used.
SG_CELINE_ROUTING=
